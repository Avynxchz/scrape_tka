      "soal_serupa": {
        "pertanyaan": "اِقْرَأِ النَّصَّ الْآتِيَ! النَّصِّ؟",
        "kunci": "C",
        "pembahasan_singkat": "Teks menunjukkan bahwa Umar datang sebelum terbit matahari dengan ikhlas menjaga keamanan, dan uslub istitsna' 'لَا يَتَغَيَّبُ ... إِلَّا إِذَا كَانَ مَرِيْضًا ... أَوْ فِي إِجَازَةٍ رَسْمِيَّةٍ' menegaskan bahwa ia pekerja yang berdisiplin tinggi serta tidak pernah absen kecuali ada halangan mendesak (Opsi C).",
        "pilihan": [
          {
            "key": "A",
            "text": "يَحْضُرُ إِلَى عَمَلِهِ فِي الْمَدْرَسَةِ فَقَطْ أَيَّامَ الْإِجَازَةِ"
          },
          {
            "key": "B",
            "text": "يَأْتِي إِلَى الْمَدْرَسَةِ مُتَأَخِّرًا بَعْدَ طُلُوْعِ الشَّمْسِ"
