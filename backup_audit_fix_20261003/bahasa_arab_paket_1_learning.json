      "pernyataan": [],
      "soal_serupa": {
        "pertanyaan": "رَتِّبِ الْكَلِمَاتِ الْآتِيَةَ لِتَكُوْنَ جُمْلَةً مُفِيْدَةً!\nالْقِصَصَ / فِي / يَقْرَأُ / الْمَكْتَبَةِ / أَحْمَدُ / الْمُفِيْدَةَ",
        "pilihan": [
          {
            "key": "A",
            "text": "يَقْرَأُ أَحْمَدُ الْقِصَصَ الْمُفِيْدَةَ فِي الْمَكْتَبَةِ"
          },
          {
            "key": "B",
            "text": "أَحْمَدُ فِي يَقْرَأُ الْمَكْتَبَةِ الْقِصَصَ الْمُفِيْدَةَ"
          },
          {
            "key": "C",
            "text": "فِي الْمَكْتَبَةِ يَقْرَأُ الْمُفِيْدَةَ الْقِصَصَ أَحْمَدُ"
          },
          {
            "key": "D",
            "text": "يَقْرَأُ الْقِصَصَ أَحْمَدُ الْمَكْتَبَةِ فِي الْمُفِيْدَةَ"
          },
          {
            "key": "E",
            "text": "الْمُفِيْدَةَ يَقْرَأُ أَحْمَدُ فِي الْمَكْتَبَةِ الْقِصَصَ"
          }
        ],
        "kunci": "A",
        "pembahasan_singkat": "Susunan jumlah fi'liyyah yang baku dan sempurna maknanya diawali oleh fi'il 'يَقْرَأُ', fa'il 'أَحْمَدُ', maf'ul bih beserta na'at-nya 'الْقِصَصَ الْمُفِيْدَةَ', lalu diakhiri oleh syibh jumlah jar-majrur 'فِي الْمَكْتَبَةِ'. Susunan yang tepat ada pada Opsi A."
      }
