      "soal_serupa": {
        "pertanyaan": "اِقْرَأِ الْحِوَارَ الْآتِيَ!\nسَلْمَانُ: السَّلَامُ عَلَيْكُمْ، مَاذَا تَفْعَلُ فِي يَوْمِ الْعُطْلَةِ يَا بِلَالُ؟\nبِلَالٌ: وَعَلَيْكُمُ السَّلَامُ، أَنَا أُمَارِسُ الرِّيَاضَةَ وَأَرْكَبُ الدَّرَّاجَةَ مَعَ أَخِي.\nسَلْمَانُ: هَلْ تُحِبُّ الرِّيَاضَةَ؟\nبِلَالٌ: نَعَمْ، هِيَ هِوَايَتِي الْمُفَضَّلَةُ. وَمَا هِوَايَتُكَ أَنْتَ؟\nسَلْمَانُ: هِوَايَتِي قِرَاءَةُ الْكُتُبِ الْعِلْمِيَّةِ فِي غُرْفَتِي.\n\nمَا الْفِكْرَةُ الرَّئِيْسِيَّةُ فِي هَذَا الْحِوَارِ؟",
        "pilihan": [
          {
            "key": "A",
            "text": "الْوَاجِبَاتُ الْمَدْرَسِيَّةُ الصَّعْبَةُ"
          },
          {
            "key": "B",
            "text": "تَبَادُلُ الْحَدِيْثِ عَنِ الْهِوَايَاتِ الْمُفَضَّلَةِ"
          },
          {
            "key": "C",
            "text": "كَيْفِيَّةُ شِرَاءِ الدَّرَّاجَةِ الْجَدِيْدَةِ"
          },
          {
            "key": "D",
            "text": "زِيَارَةُ الْمَكْتَبَةِ الْعَامَّةِ فِي الْمَدِيْنَةِ"
          },
          {
            "key": "E",
            "text": "السَّفَرُ إِلَى خَارِجِ الْبِلَادِ فِي الْعُطْلَةِ"
          }
        ],
        "kunci": "B",
        "pembahasan_singkat": "Seluruh jalannya percakapan berfokus pada kegiatan waktu luang serta kegemaran masing-masing tokoh (bersepeda dan membaca buku ilmiah), sehingga gagasan utama dialog tersebut adalah saling bertukar cerita tentang hobi kegemaran (Opsi B)."
      }
