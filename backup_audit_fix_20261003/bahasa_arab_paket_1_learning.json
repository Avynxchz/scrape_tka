      "soal_serupa": {
        "pertanyaan": "اِقْرَأِ الْحِوَارَ الْآتِيَ!\nفَرْحَانُ: مَرْحَبًا يَا يُوْسُفُ، كَمْ عُمْرُكَ الْآنَ؟\nيُوْسُفُ: أَهْلًا يَا فَرْحَانُ، عُمْرِي سِتَّةَ عَشَرَ عَامًا. وَكَمْ عُمْرُكَ أَنْتَ؟\nفَرْحَانُ: عُمْرِي ثَلَاثَةَ عَشَرَ عَامًا، وَهَذَا أَخِي إِلْيَاسُ عُمْرُهُ عَشَرَةُ أَعْوَامٍ.\n\nكَمْ عُمْرُ يُوْسُفَ فِي هَذَا الْحِوَارِ؟",
        "pilihan": [
          {
            "key": "A",
            "text": "عَشَرَةُ أَعْوَامٍ"
          },
          {
            "key": "B",
            "text": "ثَلَاثَةَ عَشَرَ عَامًا"
          },
          {
            "key": "C",
            "text": "أَرْبَعَةَ عَشَرَ عَامًا"
          },
          {
            "key": "D",
            "text": "خَمْسَةَ عَشَرَ عَامًا"
          },
          {
            "key": "E",
            "text": "سِتَّةَ عَشَرَ عَامًا"
          }
        ],
        "kunci": "E",
        "pembahasan_singkat": "Pada dialog tersebut, tokoh Yusuf secara eksplisit menjawab pertanyaan Farhan mengenai umurnya dengan menyatakan 'عُمْرِي سِتَّةَ عَشَرَ عَامًا' (umur saya 16 tahun). Maka usia Yusuf adalah 16 tahun (Opsi E)."
      }
    },
