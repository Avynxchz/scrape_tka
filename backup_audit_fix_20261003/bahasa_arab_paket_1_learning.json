      "pernyataan": [],
      "soal_serupa": {
        "pertanyaan": "اِقْرَأِ النَّصَّ الْآتِيَ!\nأَسْتَيْقِظُ كُلَّ يَوْمٍ فِي السَّاعَةِ الرَّابِعَةِ صَبَاحًا، ثُمَّ أُصَلِّي الصُّبْحَ فِي الْمَسْجِدِ. بَعْدَ الظُّهْرِ، أَرْجِعُ مِنَ الْمَدْرَسَةِ وَأَتَنَاوَلُ الْغَدَاءَ مَعَ أُخْتِي. وَفِي الْمَسَاءِ، أَقْرَأُ الْقُرْآنَ مَعَ أَبِي فِي غُرْفَةِ الْجُلُوْسِ. وَقَبْلَ أَنْ أَنَامَ، أُكْمِلُ وَاجِبَاتِي الْمَدْرَسِيَّةَ.\n\nمَاذَا يَفْعَلُ الْكَاتِبُ فِي الْمَسَاءِ؟",
        "pilihan": [
          {
            "key": "A",
            "text": "يُصَلِّي الصُّبْحَ فِي الْمَسْجِدِ"
          },
          {
            "key": "B",
            "text": "يَرْجِعُ مِنَ الْمَدْرَسَةِ وَيَتَنَاوَلُ الْغَدَاءَ"
          },
          {
            "key": "C",
            "text": "يَقْرَأُ الْقُرْآنَ مَعَ أَبِيْهِ فِي غُرْفَةِ الْجُلُوْسِ"
          },
          {
            "key": "D",
            "text": "يُكْمِلُ وَاجِبَاتِهِ الْمَدْرَسِيَّةَ قَبْلَ النَّوْمِ"
          },
          {
            "key": "E",
            "text": "يَلْعَبُ كُرَةَ الْقَدَمِ مَعَ أَصْدِقَائِهِ"
          }
        ],
        "kunci": "C",
        "pembahasan_singkat": "Berdasarkan penanda waktu petang/sore hari (فِي الْمَسَاءِ), teks secara eksplisit menyebutkan tindakan 'أَقْرَأُ الْقُرْآنَ مَعَ أَبِي فِي غُرْفَةِ الْجُلُوْسِ' (saya membaca Al-Qur'an bersama ayah saya di ruang tamu). Jika diubah ke sudut pandang orang ketiga, tindakan tersebut adalah 'يَقْرَأُ الْقُرْآنَ مَعَ أَبِيْهِ فِي غُرْفَةِ الْجُلُوْسِ' (Opsi C)."
      }
    },
