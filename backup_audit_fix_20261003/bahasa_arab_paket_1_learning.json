      "pertanyaan": {
        "text": "Tentukan Benar atau Salah untuk setiap pernyataan berikut!",
        "html": "<div class=\"col-lg-6 isi-soal\" style=\"border-left: 5px dotted rgb(238, 238, 238); height: 520px; overflow: auto;\"><!--?xml encoding=\"utf-8\" ?--><p>Tentukan <strong>Benar</strong> atau <strong>Salah</strong> untuk setiap pernyataan berikut!</p>\n<!-- PG Kompleks > 1 jawaban pilihan -->\n\n</div>",
        "images": []
      },
      "pilihan_jawaban": [],
      "pernyataan": [
        {
          "key": "A",
          "text": "Saya menyaksikan.",
          "image": null
        },
        {
          "key": "B",
          "text": "Saya bermain.",
          "image": null
        },
        {
          "key": "C",
          "text": "Saya menonton.",
          "image": null
        }
      ],
      "soal_serupa": {
        "pertanyaan": "تَأَمَّلِ الْجُمْلَةَ الْآتِيَةَ!",
        "أَسْتَمِعُ": "erikut:\n(1) Saya mendengarkan.\n(2) Saya berbicara.\n(3) Saya menyimak.\n\nUrutan status kebenaran (Benar / Salah) yang tepat untuk pernyataan (1), (2), dan (3) berturut-turut adalah....",
        "pilihan": [
          {
            "key": "A",
            "text": "Benar - Salah - Benar"
          },
          {
            "key": "B",
            "text": "Benar - Benar - Salah"
          },
          {
            "key": "C",
            "text": "Salah - Benar - Benar"
          },
          {
            "key": "D",
            "text": "Salah - Salah - Benar"
          },
          {
            "key": "E",
            "text": "Benar - Benar - Benar"
          }
        ],
        "kunci": "A",
        "pembahasan_singkat": "Kata kerja 'أَسْتَمِعُ' merupakan bentuk fi'il mudhari' mutakallim (dhamir ana) dari verba 'اِسْتَمَعَ - يَسْتَمِعُ' yang secara leksikal berarti mendengarkan atau menyimak dengan perhatian. Oleh karena itu, pernyataan (1) bernilai Benar, pernyataan (2) bernilai Salah (karena berbicara adalah 'أَتَكَلَّمُ'), dan pernyataan (3) bernilai Benar. Urutan yang tepat adalah Benar - Salah - Benar (Opsi A)."
      }
    },
