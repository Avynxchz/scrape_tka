          {
            "key": "C",
            "text": "حَارِسٌ مُجْتَهِدٌ وَمُنْضَبِطٌ لَا يَغِيْبُ إِلَّا لِعُذْرٍ قَاهِرٍ"
          },
          {
            "key": "D",
            "text": "يَتْرُكُ حِرَاسَةَ الْمَدْرَسَةِ كُلَّ أُسْبُوْعٍ دُوْنَ إِذْنٍ"
          },
          {
            "key": "E",
            "text": "يَعْمَلُ حَارِسًا فِي مَطْعَمِ الْمَدْرَسَةِ لَيْلًا فَقَطْ"
          }
        ]
