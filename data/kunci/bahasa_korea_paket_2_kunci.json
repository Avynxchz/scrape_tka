    "11": {
      "kunci": "A (O)\nB (O)\nC (X)"
    },
    "12": {
      "kunci": "(C)\n공원에서 자전거를 타요."
    },
    "13": {
      "kunci": "(D)\n여행할 때 카메라를 가져갈 겁니다."
