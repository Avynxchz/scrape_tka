      "soal_serupa": {
        "pertanyaan": "Bacalah percakapan singkat berikut!\n\n服务员：你好，你想买什么水果？(Fúwùyuán: Nǐ hǎo, nǐ xiǎng mǎi shénme shuǐguǒ?)\n顾客：我想买一些苹果和西瓜。(Gùkè: Wǒ xiǎng mǎi yìxiē píngguǒ hé xīguā.)\n\nBerdasarkan isi percakapan di atas, di manakah kemungkinan besar kedua penutur tersebut berada (他们在哪里)?",
        "pilihan": [
          {
            "key": "A",
            "text": "医院 (Yīyuàn - Rumah sakit)"
          },
          {
            "key": "B",
            "text": "学校 (Xuéxiào - Sekolah)"
          },
          {
            "key": "C",
            "text": "商店 (Shāngdiàn - Toko)"
          },
          {
            "key": "D",
            "text": "机场 (Jīchǎng - Bandara)"
          },
          {
            "key": "E",
            "text": "家 (Jiā - Rumah)"
          }
        ],
        "kunci": "C",
        "pembahasan_singkat": "Aktivitas pelayanan jual beli buah antara pelayan (服务员) dan pembeli (顾客) yang membeli buah (买水果) secara situasional berlangsung di toko (商店)."
      }
