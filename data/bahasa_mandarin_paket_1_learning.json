      "soal_serupa": {
        "pertanyaan": "Susunlah kosakata acak berikut menjadi kalimat tanya bahasa Mandarin yang baku dan tepat!\n\n“你 / 喝 / 什么 / 茶” (nǐ / hē / shénme / chá)",
        "pilihan": [
          {
            "key": "A",
            "text": "你喝什么茶？ (Nǐ hē shénme chá?)"
          },
          {
            "key": "B",
            "text": "什么茶喝你？ (Shénme chá hē nǐ?)"
          },
          {
            "key": "C",
            "text": "你茶什么喝？ (Nǐ chá shénme hē?)"
          },
          {
            "key": "D",
            "text": "喝茶什么你？ (Hē chá shénme nǐ?)"
          },
          {
            "key": "E",
            "text": "喝你什么茶？ (Hē nǐ shénme chá?)"
          }
        ],
        "kunci": "A",
        "pembahasan_singkat": "Kalimat tanya bahasa Mandarin mengikuti struktur dasar Subjek (你) + Predikat Verba (喝) + Objek Frasa Nomina (什么茶), sehingga susunan yang benar adalah '你喝什么茶？'."
      }
    },
