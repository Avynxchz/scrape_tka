# ==============================================================================
# CONFIGURASI AI TUTOR (SCRAPE TKA)
# ==============================================================================

# PILIHAN 1: GROQ CLOUD (SANGAT DIREKOMENDASIKAN - GRATIS & SUPER CEPAT ~1 DETIK)
# Daftar gratis di: https://console.groq.com/keys
# Model cepat: llama-3.1-8b-instant atau qwen-2.5-32b
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=gsk_MASUKKAN_API_KEY_GROQ_DI_SINI

# PILIHAN 2: OPENROUTER
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-7b-instruct
# LLM_API_KEY=sk-or-v1-MASUKKAN_API_KEY_DI_SINI

# PILIHAN 3: OLLAMA LOKAL (DEFAULT JIKA ENV DI ATAS KOSONG)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:1.7b

# PENGATURAN RATE LIMIT & ANTI-SPAM (PER USER)
RATE_LIMIT_COOLDOWN_SEC=1.5
RATE_LIMIT_MAX_PER_MIN=20
