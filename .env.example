# ==============================================================================
# CONFIGURASI AI TUTOR (SCRAPE TKA) - MULTI-API KEY ROTATION
# ==============================================================================

# PILIHAN 1: GROQ CLOUD MULTI-KEY (SANGAT DIREKOMENDASIKAN UNTUK 50 MURID)
# Daftar gratis di: https://console.groq.com/keys (bisa daftar 3 akun untuk 3 keys)
# Masukkan 1 sampai 3 key dipisahkan koma. Sistem otomatis memutar (round-robin)
# dan otomatis failover jika salah satu key mencapai rate limit!
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEYS=gsk_AKUN_1_DISINI,gsk_AKUN_2_DISINI,gsk_AKUN_3_DISINI

# PILIHAN 2: OPENROUTER (JIKA PAKAI OPENROUTER)
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-7b-instruct
# LLM_API_KEYS=sk-or-v1-KEY1,sk-or-v1-KEY2

# PILIHAN 3: OLLAMA LOKAL (DEFAULT JIKA ENV DI ATAS KOSONG)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:1.7b

# PENGATURAN RATE LIMIT & KONKURENSI
RATE_LIMIT_COOLDOWN_SEC=1.5
RATE_LIMIT_MAX_PER_MIN=20
LLM_MAX_CONCURRENT=6

# KUNCI ADMIN DASHBOARD PENGUNJUNG (WAJIB diisi di .env asli, jangan pakai nilai contoh ini)
# Server menolak start bila VISITOR_ADMIN_KEY kosong (fail-fast keamanan).
VISITOR_ADMIN_KEY=isi_dengan_kunci_acak_yang_kuat
